APP_NAME=my-car-admin-api
ENV=dev
API_V1_PREFIX=/api/v1

# 浏览器访问管理后台的完整 Origin，逗号分隔。缺省会导致跨域预检无 Access-Control-Allow-Origin。
# 生产示例：CORS_ORIGINS=http://admin.breakcode.top,https://admin.breakcode.top
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# 上传返回给前端的资源 URL 前缀，须为公网可访问域名（勿用 127.0.0.1，否则线上页面无法加载 /media）。
# 生产示例（与 Nginx server_name、location /media 一致）：MEDIA_BASE_URL=http://api.breakcode.top/media
# MEDIA_BASE_URL=http://127.0.0.1:8000/media

JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=my_car_admin

# 上传文件目录：不设则默认相对路径 uploads（相对 uvicorn 工作目录）
# 生产示例（按需取消注释）：
UPLOAD_DIR=/data/my-car/uploads

ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin123456
